# Copia este fichero a «.env» en el servidor y rellénalo. «.env» NO se sube al repositorio.
# Las contraseñas y claves se generan largas y al azar (openssl rand -base64 32); nunca se reutilizan.

# --- Dónde -----------------------------------------------------------------------------------------------------------
# Tu dominio, o si no tienes: la IP del servidor con guiones y «.sslip.io» (203.0.113.7 → 203-0-113-7.sslip.io).
DOMINIO=

# --- Imágenes --------------------------------------------------------------------------------------------------------
# Tu usuario de GitHub en minúsculas (las imágenes están en ghcr.io/<usuario>/vigia-*), y la versión a desplegar (un tag: 1.0.0).
PROPIETARIO=
VERSION=latest

# --- Secretos --------------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# El hash de la contraseña del panel (no la contraseña): dotnet run --project src/Vigia.Api -- hash-contrasena
ACCESO_HASH=
# Firma las sesiones. 32 caracteres o más, al azar.
ACCESO_CLAVE_JWT=

# --- Avisos (todo opcional: un canal solo se usa si está completo) --------------------------------------------------------
CORREO_SERVIDOR=
CORREO_PUERTO=587
CORREO_USAR_TLS=true
CORREO_REMITENTE=
CORREO_USUARIO=
CORREO_CONTRASENA=
AVISOS_CORREO_0=
AVISOS_CORREO_1=
# El token lo da @BotFather al crear el bot; el chat es el identificador de la conversación con él.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_0=
