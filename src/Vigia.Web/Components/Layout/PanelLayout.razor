@inherits LayoutComponentBase

<a class="saltar" href="#contenido">Saltar al contenido</a>

<header class="cabecera">
    <a class="marca" href="/" aria-label="Vigía, inicio del panel">Vigía</a>
    <nav aria-label="Principal">
        <NavLink href="" Match="NavLinkMatch.All">Panel</NavLink>
        <NavLink href="grupos">Grupos</NavLink>
        <NavLink href="mantenimientos">Mantenimiento</NavLink>
    </nav>
    <form method="post" action="/salir" class="salir">
        <AntiforgeryToken />
        <button type="submit" class="enlace">Salir</button>
    </form>
</header>

<main id="contenido" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" role="alert" hidden>
    Ha ocurrido un error inesperado.
    <a href="" class="recargar">Recargar</a>
</div>
